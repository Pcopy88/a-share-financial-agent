# Copy to .env after development. Never commit real credentials.
# mock is explicit development mode, never a real model quality result.
ARA_MODE=mock
ARA_DATA_DIR=data
ARA_OUTPUT_DIR=outputs
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
DASHSCOPE_API_KEY=
# Full URL from your Bailian account; region and workspace must match the Key.
DASHSCOPE_EMBEDDING_URL=
ARA_EMBEDDING_MODEL=text-embedding-v3
ARA_EMBEDDING_DIMENSION=1024
ARA_RETRIEVAL_MODE=dense
ARA_RERANK_ENABLED=false
ARA_RERANK_DEVICE=auto
ARA_RERANK_BATCH_SIZE=2
ARA_RERANK_MAX_LENGTH=1024
ARA_API_HOST=127.0.0.1
ARA_API_PORT=8000
ARA_UI_PORT=8501
ARA_API_URL=http://127.0.0.1:8000
